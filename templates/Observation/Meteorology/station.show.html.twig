{% extends 'base.html.twig' %}

{% set active = 'stations' %}
{% block title %}{{ station ? station.name : ('common.unknown'|trans) }} · {{ 'nav.brand'|trans }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('home') }}">{{ 'common.home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('stations_index') }}">{{ 'station.breadcrumb'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">
                {{ station ? station.name : ('common.unknown'|trans) }}
            </li>
        </ol>
    </nav>

    {% if error %}
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            {{ 'station.could_not_load_station'|trans }}{% if app_debug %}<code>{{ error }}</code>{% endif %}
        </div>
    {% elseif station %}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h1 class="h3 mb-1">
                    <i class="bi bi-broadcast-pin text-primary me-2" aria-hidden="true"></i>{{ station.name }}
                </h1>
                <p class="text-body-secondary mb-0">
                    {{ 'station.col_id'|trans }} <code>{{ station.id }}</code> ·
                    {{ station.latitude|number_format(4) }}, {{ station.longitude|number_format(4) }}
                    <a class="ms-2"
                        target="_blank"
                        rel="noopener"
                        href="https://www.openstreetmap.org/?mlat={{ station.latitude }}&mlon={{ station.longitude }}#map=12/{{ station.latitude }}/{{ station.longitude }}">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> {{ 'location.map'|trans }}
                    </a>
                </p>
            </div>
        </div>

        {% if latest %}
            <section class="mb-4" aria-labelledby="latest-heading">
                <h2 id="latest-heading" class="h5 mb-3">
                    <i class="bi bi-speedometer2 me-2 text-primary" aria-hidden="true"></i>{{ 'station.latest_reading'|trans }}
                    <span class="text-body-secondary small ms-1">
                        · {{ latest.at|date('Y-m-d H:i', timezone) }}
                        <span class="text-body-tertiary">({{ timezone }})</span>
                    </span>
                </h2>
                <div class="row row-cols-2 row-cols-md-4 g-3">
                    {% set tiles = [
                        { icon: 'bi-thermometer-half', key: 'station.tile_temperature',  value: latest.temperature_c,    unit: '°C',   decimals: 1, color: 'danger' },
                        { icon: 'bi-droplet-half',     key: 'station.tile_humidity',     value: latest.humidity_pct,     unit: '%',    decimals: 0, color: 'info' },
                        { icon: 'bi-speedometer',      key: 'station.tile_pressure',     value: latest.pressure_hpa,     unit: 'hPa',  decimals: 1, color: 'secondary' },
                        { icon: 'bi-cloud-rain',       key: 'station.tile_precipitation',value: latest.precipitation_mm, unit: 'mm',   decimals: 1, color: 'primary' },
                        { icon: 'bi-sun',              key: 'station.tile_radiation',    value: latest.radiation_wm2,    unit: 'W/m²', decimals: 0, color: 'warning' },
                        { icon: 'bi-wind',             key: 'station.tile_wind_speed',   value: latest.wind_speed_kmh,   unit: 'km/h', decimals: 1, color: 'primary' },
                    ] %}
                    {% for tile in tiles %}
                        <div class="col">
                            <div class="card h-100 border-start border-3 border-{{ tile.color }}">
                                <div class="card-body py-3">
                                    <div class="small text-body-secondary">
                                        <i class="bi {{ tile.icon }} me-1" aria-hidden="true"></i>{{ tile.key|trans }}
                                    </div>
                                    <div class="h5 mb-0">
                                        {% if tile.value is not null %}
                                            {{ tile.value|number_format(tile.decimals) }}
                                            <span class="text-body-secondary small">{{ tile.unit }}</span>
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    <div class="col">
                        <div class="card h-100 border-start border-3 border-info">
                            <div class="card-body py-3">
                                <div class="small text-body-secondary">
                                    <i class="bi bi-compass me-1" aria-hidden="true"></i>{{ 'station.tile_wind_direction'|trans }}
                                </div>
                                <div class="h5 mb-0">
                                    {% if latest.wind_dir_code %}
                                        {{ latest.wind_dir_code }}
                                        <span class="text-body-secondary small">· {{ latest.wind_dir_label|trans }}</span>
                                    {% else %}
                                        <span class="text-body-secondary">{{ latest.wind_dir_label|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {% endif %}

        <section aria-labelledby="history-heading">
            <h2 id="history-heading" class="h5 mb-3">
                <i class="bi bi-clock-history me-2 text-primary" aria-hidden="true"></i>{{ 'station.history_heading'|trans }}
            </h2>
            {% if observation_error %}
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                    {{ 'station.could_not_load_obs'|trans }}{% if app_debug %}<code>{{ observation_error }}</code>{% endif %}
                </div>
            {% elseif history is empty %}
                <div class="alert alert-warning" role="alert">
                    {{ 'station.no_recent_readings'|trans }}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm align-middle bg-body shadow-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{ 'station.col_time'|trans }} <span class="text-body-tertiary fw-normal">({{ timezone }})</span></th>
                                <th scope="col" class="text-end">{{ 'station.col_temp'|trans }}</th>
                                <th scope="col" class="text-end">{{ 'station.col_humidity'|trans }}</th>
                                <th scope="col" class="text-end">{{ 'station.col_pressure'|trans }}</th>
                                <th scope="col" class="text-end">{{ 'station.col_rain'|trans }}</th>
                                <th scope="col" class="text-end">{{ 'station.col_wind'|trans }}</th>
                                <th scope="col" class="text-center">{{ 'station.col_dir'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in history %}
                                <tr>
                                    <td>{{ row.at|date('Y-m-d H:i', timezone) }}</td>
                                    <td class="text-end">
                                        {% if row.temperature_c is not null %}
                                            {{ row.temperature_c|number_format(1) }} °C
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if row.humidity_pct is not null %}
                                            {{ row.humidity_pct|number_format(0) }} %
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if row.pressure_hpa is not null %}
                                            {{ row.pressure_hpa|number_format(1) }}
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if row.precipitation_mm is not null %}
                                            {{ row.precipitation_mm|number_format(1) }} mm
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if row.wind_speed_kmh is not null %}
                                            {{ row.wind_speed_kmh|number_format(1) }} km/h
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if row.wind_dir_code %}
                                            <span class="badge text-bg-light border" title="{{ row.wind_dir_label|trans }}">
                                                {{ row.wind_dir_code }}
                                            </span>
                                        {% else %}
                                            <span class="text-body-secondary">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        {% for chart in trend_charts %}
            <section class="mt-4" aria-labelledby="trend-{{ chart.id }}-heading">
                <h2 id="trend-{{ chart.id }}-heading" class="h5 mb-1">
                    <i class="bi {{ chart.icon }} me-2 text-primary" aria-hidden="true"></i>{{ chart.heading|trans }}
                </h2>
                <p class="text-body-secondary small mb-3">{{ 'station.trend_subtitle'|trans }}</p>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div style="position: relative; height: 18rem;">
                            <canvas id="trend-{{ chart.id }}"
                                    role="img"
                                    aria-label="{{ chart.heading|trans }}"></canvas>
                        </div>
                    </div>
                </div>
            </section>
        {% endfor %}

        {% if wind_rose %}
            <section class="mt-4" aria-labelledby="wind-rose-heading">
                <h2 id="wind-rose-heading" class="h5 mb-1">
                    <i class="bi bi-compass me-2 text-primary" aria-hidden="true"></i>{{ 'station.wind_rose_heading'|trans }}
                </h2>
                <p class="text-body-secondary small mb-3">{{ 'station.wind_rose_subtitle_speed'|trans }}</p>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mx-auto" style="max-width: 22rem;">
                            <canvas id="wind-rose"
                                    role="img"
                                    aria-label="{{ 'station.wind_rose_aria'|trans }}"></canvas>
                        </div>
                        {# Colour scale: sector fill encodes average wind speed.
                           Endpoints match SPEED_MAX (40 km/h) and the blue→red
                           HSL ramp in the chart script below. #}
                        <div class="mx-auto mt-3" style="max-width: 18rem;">
                            <div class="rounded" style="height: 0.6rem; background: linear-gradient(to right, hsl(240,70%,50%), hsl(180,70%,50%), hsl(120,70%,50%), hsl(60,70%,50%), hsl(0,70%,50%));"></div>
                            <div class="d-flex justify-content-between text-body-secondary small mt-1">
                                <span>0</span>
                                <span>{{ 'station.wind_rose_speed_legend'|trans }}</span>
                                <span>≥ 40 km/h</span>
                            </div>
                        </div>
                        {% if wind_rose_calm > 0 %}
                            <p class="text-body-secondary small text-center mt-3 mb-0">
                                <i class="bi bi-wind me-1" aria-hidden="true"></i>{{ 'station.wind_rose_calm'|trans({ '%count%': wind_rose_calm }) }}
                            </p>
                        {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
{% if wind_rose or trend_charts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"
        integrity="sha384-JUh163oCRItcbPme8pYnROHQMC6fNKTBWtRG3I3I0erJkzNgL7uxKlNwcrcFKeqF"
        crossorigin="anonymous"></script>
{% endif %}
{% if wind_rose %}
<script id="wind-rose-data" type="application/json">{{ {
    labels: wind_rose.sectors|map(s => s.code),
    counts: wind_rose.sectors|map(s => s.count),
    avgSpeeds: wind_rose.sectors|map(s => s.avg_speed),
    i18n: {
        hours: 'station.wind_rose_hours_label'|trans,
        avgSpeed: 'station.wind_rose_avg_speed'|trans,
        noSpeed: 'station.wind_rose_no_speed'|trans,
    },
}|json_encode|raw }}</script>
<script>
    (function () {
        var data = JSON.parse(document.getElementById('wind-rose-data').textContent);

        // Top of the colour scale, in km/h. Average hourly speeds rarely
        // exceed this, and a fixed domain keeps colours comparable between
        // stations. Speed maps to a hue ramp: blue (calm) → red (strong).
        var SPEED_MAX = 40;
        function speedColor(speed, alpha) {
            if (speed === null || speed === undefined) {
                return 'rgba(173, 181, 189, ' + alpha + ')'; // grey: no speed data
            }
            var t = Math.max(0, Math.min(1, speed / SPEED_MAX));
            var hue = 240 - 240 * t; // 240° blue → 0° red
            return 'hsla(' + hue + ', 70%, 50%, ' + alpha + ')';
        }

        // Paints the compass codes (N, NE, …) around the rim at their true
        // bearings. Labels are ordered N→NW, i.e. 0°, 45°, … 315° clockwise
        // from the top — matching the chart's -22.5° start angle.
        var compassLabels = {
            id: 'compassLabels',
            afterDraw: function (chart) {
                var scale = chart.scales.r;
                if (!scale) {
                    return;
                }
                var ctx = chart.ctx;
                var radius = scale.drawingArea + 16;
                ctx.save();
                ctx.font = '600 13px system-ui, sans-serif';
                ctx.fillStyle = '#6c757d';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                chart.data.labels.forEach(function (label, i) {
                    var bearing = (Math.PI / 180) * (i * 45);
                    var x = scale.xCenter + radius * Math.sin(bearing);
                    var y = scale.yCenter - radius * Math.cos(bearing);
                    ctx.fillText(label, x, y);
                });
                ctx.restore();
            },
        };

        new Chart(document.getElementById('wind-rose'), {
            type: 'polarArea',
            data: {
                labels: data.labels,
                datasets: [{
                    data: data.counts,
                    // Radius = hours from each direction; fill colour = the
                    // average wind speed recorded from that direction.
                    backgroundColor: data.avgSpeeds.map(function (s) { return speedColor(s, 0.6); }),
                    borderColor: data.avgSpeeds.map(function (s) { return speedColor(s, 0.95); }),
                    borderWidth: 1,
                }],
            },
            options: {
                responsive: true,
                // Leave room around the rim for the compass labels.
                layout: { padding: 24 },
                scales: {
                    r: {
                        beginAtZero: true,
                        // Chart.js v4 polar-area rotation lives on the radial
                        // scale (the chart-level `startAngle` option is ignored
                        // for polar charts). The default of 0 already centres
                        // the first sector (N) at the top, with each 45° sector
                        // centred on its compass point — exactly what we want.
                        startAngle: -22.5,
                        ticks: { precision: 0, backdropColor: 'transparent' },
                    },
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                return ctx.label + ': ' + ctx.raw + ' ' + data.i18n.hours;
                            },
                            afterLabel: function (ctx) {
                                var speed = data.avgSpeeds[ctx.dataIndex];
                                if (speed === null || speed === undefined) {
                                    return data.i18n.avgSpeed + ': ' + data.i18n.noSpeed;
                                }
                                return data.i18n.avgSpeed + ': ' + speed.toFixed(1) + ' km/h';
                            },
                        },
                    },
                },
            },
            plugins: [compassLabels],
        });
    })();
</script>
{% endif %}
{% if trend_charts %}
<script id="trend-data" type="application/json">{{ {
    labels: trend_labels|map(d => d|date('H:i', timezone)),
    dirLabel: 'station.wind_dir_tooltip'|trans,
    charts: trend_charts|map(c => {
        id: c.id,
        unit: c.unit,
        color: c.color,
        decimals: c.decimals,
        zero: c.zero,
        values: c.values,
        bearings: c.bearings|default(null),
        dirCodes: c.dir_codes|default(null),
    }),
}|json_encode|raw }}</script>
<script>
    (function () {
        var data = JSON.parse(document.getElementById('trend-data').textContent);

        // Draws an upward-pointing arrow (north / 0°) onto a small canvas, used
        // as a Chart.js point style. pointRotation then turns it to the wind
        // direction. Returns a canvas so it renders synchronously (no onload).
        function makeArrow(color) {
            var size = 20, cx = size / 2;
            var canvas = document.createElement('canvas');
            canvas.width = canvas.height = size;
            var ctx = canvas.getContext('2d');
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.beginPath();          // shaft
            ctx.moveTo(cx, size - 4);
            ctx.lineTo(cx, 7);
            ctx.stroke();
            ctx.beginPath();          // head
            ctx.moveTo(cx, 2);
            ctx.lineTo(cx - 4, 9);
            ctx.lineTo(cx + 4, 9);
            ctx.closePath();
            ctx.fill();
            return canvas;
        }

        data.charts.forEach(function (c) {
            var el = document.getElementById('trend-' + c.id);
            if (!el) {
                return;
            }

            var dataset = {
                data: c.values,
                borderColor: 'rgba(' + c.color + ', 0.9)',
                backgroundColor: 'rgba(' + c.color + ', 0.12)',
                borderWidth: 2,
                fill: true,
                // Spline smoothing.
                tension: 0.4,
                // Bridge the occasional missing hourly reading.
                spanGaps: true,
                pointRadius: 2,
                pointHoverRadius: 5,
            };

            // Wind speed: render each point as a direction arrow. Calm/unknown
            // hours (null bearing) keep a plain dot.
            if (c.bearings) {
                var arrow = makeArrow('rgba(' + c.color + ', 0.95)');
                dataset.pointStyle = c.bearings.map(function (b) {
                    return b === null ? 'circle' : arrow;
                });
                // Arrow points north at 0°; rotate to the downwind bearing
                // (from-bearing + 180) so it shows where the wind is heading.
                dataset.pointRotation = c.bearings.map(function (b) {
                    return b === null ? 0 : (b + 180) % 360;
                });
                dataset.pointRadius = c.bearings.map(function (b) {
                    return b === null ? 2 : 9;
                });
                dataset.pointHoverRadius = c.bearings.map(function (b) {
                    return b === null ? 4 : 11;
                });
            }

            new Chart(el, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [dataset],
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: {
                            beginAtZero: c.zero,
                            title: { display: true, text: c.unit },
                        },
                        x: {
                            ticks: { maxRotation: 0, autoSkipPadding: 12 },
                        },
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ctx.parsed.y.toFixed(c.decimals) + ' ' + c.unit;
                                },
                                afterLabel: function (ctx) {
                                    if (!c.dirCodes) {
                                        return undefined;
                                    }
                                    var code = c.dirCodes[ctx.dataIndex];
                                    return code ? data.dirLabel + ': ' + code : undefined;
                                },
                            },
                        },
                    },
                },
            });
        });
    })();
</script>
{% endif %}
{% endblock %}
