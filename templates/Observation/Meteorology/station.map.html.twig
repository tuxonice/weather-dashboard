{% extends 'base.html.twig' %}

{% set active = 'stations' %}
{% block title %}{{ 'station.map_title'|trans }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""/>
<style>
    #station-map {
        height: 70vh;
        min-height: 420px;
        border-radius: .5rem;
        z-index: 0;
    }
    .station-marker {
        border: 2px solid #fff;
        border-radius: 999px;
        box-shadow: 0 1px 3px rgba(0,0,0,.25);
        color: #111;
        font: 600 11px/1 system-ui, sans-serif;
        text-align: center;
        white-space: nowrap;
    }
    .station-marker--missing {
        background: #e9ecef;
        color: #6c757d;
    }
    .leaflet-popup-content dl { margin: 0; }
    .leaflet-popup-content dt { font-weight: 600; }
    .leaflet-popup-content dd { margin: 0 0 .25rem 0; }
</style>
{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-map text-primary me-2" aria-hidden="true"></i>{{ 'station.map_heading'|trans }}
            </h1>
            <p class="text-body-secondary mb-0">
                {{ 'station.map_subtitle'|trans }}
                {% if updated_at %}
                    <span class="ms-1">{{ 'station.map_reported_at'|trans({ '%datetime%': updated_at|date('Y-m-d H:i', timezone) }) }}</span>
                {% endif %}
                {% if stations_count %}
                    <span class="ms-1">{{ 'station.map_count'|trans({ '%count%': stations_count, '%active_count%': stations_active_count }) }}</span>
                {% endif %}
            </p>
        </div>
        <div class="btn-group" role="group" aria-label="{{ 'station.heading'|trans }}">
            <a href="{{ path('stations_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-table me-1" aria-hidden="true"></i>{{ 'station.table'|trans }}
            </a>
            <a href="{{ path('stations_map') }}" class="btn btn-primary" aria-current="page">
                <i class="bi bi-map me-1" aria-hidden="true"></i>{{ 'station.map'|trans }}
            </a>
        </div>
    </div>

    {% if error %}
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            {{ 'station.map_load_error'|trans }}{% if app_debug %}<code>{{ error }}</code>{% endif %}
        </div>
    {% else %}
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="text-body-secondary small me-1"><i class="bi bi-layers me-1" aria-hidden="true"></i></span>
            {# Six layers no longer fit a phone's width; scroll the group in its
               own box rather than letting it widen the page body. #}
            <div class="overflow-x-auto mw-100" style="min-width: 0;">
            <div class="btn-group btn-group-sm" role="group" id="layer-switcher" aria-label="{{ 'station.map_heading'|trans }}">
                <button type="button" class="btn btn-primary"          data-layer="temperature"><i class="bi bi-thermometer-half me-1" aria-hidden="true"></i>{{ 'station.map_layer_temperature'|trans }}</button>
                <button type="button" class="btn btn-outline-secondary" data-layer="apparent_temp"><i class="bi bi-thermometer-sun me-1" aria-hidden="true"></i>{{ 'station.map_layer_apparent_temp'|trans }}</button>
                <button type="button" class="btn btn-outline-secondary" data-layer="humidity">   <i class="bi bi-droplet-half me-1"    aria-hidden="true"></i>{{ 'station.map_layer_humidity'|trans }}</button>
                <button type="button" class="btn btn-outline-secondary" data-layer="wind">        <i class="bi bi-wind me-1"             aria-hidden="true"></i>{{ 'station.map_layer_wind'|trans }}</button>
                <button type="button" class="btn btn-outline-secondary" data-layer="rain">        <i class="bi bi-cloud-rain me-1"       aria-hidden="true"></i>{{ 'station.map_layer_rain'|trans }}</button>
                <button type="button" class="btn btn-outline-secondary" data-layer="pressure">    <i class="bi bi-speedometer2 me-1"     aria-hidden="true"></i>{{ 'station.map_layer_pressure'|trans }}</button>
            </div>
            </div>
        </div>

        <div id="station-map" role="img" aria-label="{{ 'station.map_aria'|trans }}"></div>

        <p class="small text-body-secondary mt-3 mb-0" id="map-legend"></p>
    {% endif %}
{% endblock %}

{% block javascripts %}
{% if not error %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<script id="stations-data" type="application/json">{{ stations_json|raw }}</script>
<script id="station-i18n" type="application/json">{{ {
    temperature:   'station.tile_temperature'|trans,
    apparent_temp: 'station.col_apparent_temp'|trans,
    apparent_assumed: 'station.apparent_wind_assumed'|trans,
    humidity:      'station.tile_humidity'|trans,
    pressure:      'station.tile_pressure'|trans,
    rain:          'station.col_rain'|trans,
    wind:          'station.col_wind'|trans,
    open:          'common.open_details'|trans,
    station:       'station.col_station'|trans,
    layer_legend:  'station.map_layer_legend'|trans,
    no_reading:    'station.map_no_reading'|trans,
}|json_encode|raw }}</script>
<script>
    (function () {
        var raw = document.getElementById('stations-data').textContent;
        var stations = JSON.parse(raw);
        var i18n = JSON.parse(document.getElementById('station-i18n').textContent);
        var detailUrlTemplate = {{ path('stations_show', { id: 999999999 })|json_encode|raw }};

        var map = L.map('station-map', {
            center: [39.5, -8.0],
            zoom: 7,
            scrollWheelZoom: true,
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        function rgb(c) { return 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')'; }

        function interpolateStops(value, stops) {
            if (value === null || value === undefined) return null;
            if (value <= stops[0].t) return stops[0].c;
            for (var i = 1; i < stops.length; i++) {
                if (value <= stops[i].t) {
                    var a = stops[i - 1], b = stops[i], k = (value - a.t) / (b.t - a.t);
                    return [
                        Math.round(a.c[0] + (b.c[0] - a.c[0]) * k),
                        Math.round(a.c[1] + (b.c[1] - a.c[1]) * k),
                        Math.round(a.c[2] + (b.c[2] - a.c[2]) * k),
                    ];
                }
            }
            return stops[stops.length - 1].c;
        }

        function contrastColor(c) {
            var r = c[0] / 255, g = c[1] / 255, b = c[2] / 255;
            var lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
            return lum < 0.45 ? '#fff' : '#000';
        }

        // Shared by the measured- and apparent-temperature layers so the two
        // are directly comparable when switching between them.
        var TEMPERATURE_STOPS = [
            { t:  0, c: [ 33, 102, 172] },
            { t: 10, c: [ 67, 147, 195] },
            { t: 15, c: [146, 197, 222] },
            { t: 20, c: [254, 224, 139] },
            { t: 25, c: [244, 165,  68] },
            { t: 30, c: [215,  48,  39] },
            { t: 35, c: [140,  10,  20] },
        ];

        var LAYERS = {
            temperature: {
                field: 'temperature_c',
                unit: '°C',
                decimals: 1,
                labelFn: function (v) { return v === null ? null : Math.round(v) + '°'; },
                stops: TEMPERATURE_STOPS,
            },
            apparent_temp: {
                field: 'apparent_temperature_c',
                unit: '°C',
                decimals: 1,
                labelFn: function (v) { return v === null ? null : Math.round(v) + '°'; },
                stops: TEMPERATURE_STOPS,
            },
            humidity: {
                field: 'humidity_pct',
                unit: '%',
                decimals: 0,
                labelFn: function (v) { return v === null ? null : Math.round(v) + '%'; },
                stops: [
                    { t:   0, c: [255, 255, 255] },
                    { t:  40, c: [144, 202, 249] },
                    { t:  70, c: [  2, 119, 189] },
                    { t: 100, c: [  1,  87, 155] },
                ],
            },
            wind: {
                field: 'wind_speed_kmh',
                unit: 'km/h',
                decimals: 0,
                labelFn: function (v) { return v === null ? null : Math.round(v) + ''; },
                stops: [
                    { t:  0, c: [232, 245, 233] },
                    { t: 20, c: [129, 199, 132] },
                    { t: 40, c: [ 56, 142,  60] },
                    { t: 60, c: [ 27,  94,  32] },
                    { t: 80, c: [  0,  51,   0] },
                ],
                iconSize: [36, 36],
                iconHtmlFn: function (s, bg, fg) {
                    var speed = s.wind_speed_kmh;
                    var bearing = s.wind_dir_bearing;
                    if (speed === null || speed === undefined) {
                        return '<div class="station-marker station-marker--missing" style="width:36px;height:36px;display:flex;flex-direction:column;align-items:center;justify-content:center;">'
                             + '<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="3"/></svg></div>';
                    }
                    var arrowSvg = (bearing !== null && bearing !== undefined)
                        ? '<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="transform:rotate(' + bearing + 'deg);display:block;flex-shrink:0;">'
                          + '<path d="M8 1l2.5 10.5L8 10l-2.5 2.5z"/>'
                          + '</svg>'
                        : '<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="display:block;flex-shrink:0;"><circle cx="8" cy="8" r="3"/></svg>';
                    return '<div class="station-marker" style="background:' + bg + ';color:' + fg + ';width:36px;height:36px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:2px 0;">'
                         + arrowSvg
                         + '<span style="font:600 12px/1 system-ui,sans-serif;">' + Math.round(speed) + '</span>'
                         + '</div>';
                },
            },
            rain: {
                field: 'precipitation_mm',
                unit: 'mm',
                decimals: 1,
                labelFn: function (v) { return v === null ? null : Number(v).toFixed(1); },
                stops: [
                    { t:  0,  c: [255, 255, 255] },
                    { t:  2,  c: [179, 218, 241] },
                    { t:  5,  c: [ 66, 146, 198] },
                    { t: 10,  c: [  8,  81, 156] },
                    { t: 20,  c: [  2,  56, 88 ] },
                ],
            },
            pressure: {
                field: 'pressure_hpa',
                unit: 'hPa',
                decimals: 0,
                labelFn: function (v) { return v === null ? null : Math.round(v) + ''; },
                stops: [
                    { t:  970, c: [ 33, 102, 172] },
                    { t:  995, c: [178, 171, 210] },
                    { t: 1013, c: [247, 247, 247] },
                    { t: 1020, c: [253, 184,  99] },
                    { t: 1035, c: [178,  24,  43] },
                ],
            },
        };

        function fmt(value, unit, decimals) {
            if (value === null || value === undefined) return '—';
            return Number(value).toFixed(decimals == null ? 1 : decimals) + '\u00a0' + unit;
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[c];
            });
        }

        var activeMarkers = [];
        var bounds = [];

        stations.forEach(function (s) { bounds.push([s.lat, s.lng]); });
        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [20, 20] });
        }

        function buildPopup(s) {
            return '<strong>' + escapeHtml(s.name || i18n.station) + '</strong>'
                + '<div class="small text-body-secondary mb-2">#' + escapeHtml(s.id) + '</div>'
                + '<dl class="small">'
                +   '<dt>' + escapeHtml(i18n.temperature) + '</dt><dd>' + fmt(s.temperature_c, '°C', 1) + '</dd>'
                +   '<dt>' + escapeHtml(i18n.apparent_temp) + '</dt><dd>'
                +     (s.apparent_wind_assumed
                        ? '<em title="' + escapeHtml(i18n.apparent_assumed) + '">\u2248' + fmt(s.apparent_temperature_c, '°C', 1) + '</em>'
                        : fmt(s.apparent_temperature_c, '°C', 1))
                +     '</dd>'
                +   '<dt>' + escapeHtml(i18n.humidity)    + '</dt><dd>' + fmt(s.humidity_pct,  '%', 0) + '</dd>'
                +   '<dt>' + escapeHtml(i18n.pressure)    + '</dt><dd>' + fmt(s.pressure_hpa,  'hPa', 1) + '</dd>'
                +   '<dt>' + escapeHtml(i18n.rain)        + '</dt><dd>' + fmt(s.precipitation_mm, 'mm', 1) + '</dd>'
                +   '<dt>' + escapeHtml(i18n.wind)        + '</dt><dd>' + fmt(s.wind_speed_kmh, 'km/h', 1)
                +     (s.wind_dir_code ? ' ' + escapeHtml(s.wind_dir_code) : '') + '</dd>'
                + '</dl>'
                + '<a href="' + detailUrlTemplate.replace('999999999', encodeURIComponent(s.id)) + '">' + escapeHtml(i18n.open) + ' →</a>';
        }

        function renderLayer(layerId) {
            activeMarkers.forEach(function (m) { map.removeLayer(m); });
            activeMarkers = [];

            var layer = LAYERS[layerId];

            var isCategorical = !!layer.categorical;

            var values = !isCategorical ? stations.map(function (s) {
                var v = s[layer.field];
                return (v === null || v === undefined) ? null : Number(v);
            }).filter(function (v) { return v !== null; }) : [];

            var minVal = values.length ? Math.min.apply(null, values) : null;
            var maxVal = values.length ? Math.max.apply(null, values) : null;

            stations.forEach(function (s) {
                var value = s[layer.field];
                var numVal = (!isCategorical && value !== null && value !== undefined) ? Number(value) : null;
                var c = isCategorical ? layer.colorFn(value, s) : interpolateStops(numVal, layer.stops);
                var bg = c ? rgb(c) : '#e9ecef';
                var fg = c ? contrastColor(c) : '#6c757d';
                var iconHtml;
                if (layer.iconHtmlFn) {
                    iconHtml = layer.iconHtmlFn(s, bg, fg);
                } else {
                    var labelInput = isCategorical ? value : numVal;
                    var rawLabel = layer.labelFn(labelInput);
                    var label = rawLabel === null ? '—' : rawLabel;
                    var isMissing = isCategorical ? !c : numVal === null;
                    var cls = 'station-marker' + (isMissing ? ' station-marker--missing' : '');
                    iconHtml = '<div class="' + cls + '" style="background:' + bg + ';color:' + fg + ';padding:4px 6px;">' + escapeHtml(label) + '</div>';
                }

                var sz = layer.iconSize || [38, 22];
                var icon = L.divIcon({
                    className: '',
                    html: iconHtml,
                    iconSize: sz,
                    iconAnchor: [sz[0] / 2, sz[1] / 2],
                });

                var marker = L.marker([s.lat, s.lng], { icon: icon, title: s.name || (i18n.station + ' ' + s.id) });
                marker.bindPopup(buildPopup(s));
                marker.addTo(map);
                activeMarkers.push(marker);
            });

            var legendEl = document.getElementById('map-legend');
            if (legendEl) {
                if (!isCategorical && minVal !== null && maxVal !== null) {
                    var text = i18n.layer_legend
                        .replace('%min%', Number(minVal).toFixed(layer.decimals))
                        .replace('%max%', Number(maxVal).toFixed(layer.decimals))
                        .replace('%unit%', layer.unit);
                    legendEl.textContent = text;
                } else {
                    legendEl.textContent = '';
                }
            }
        }

        var SESSION_KEY = 'station_map_layer';
        var savedLayer = sessionStorage.getItem(SESSION_KEY);
        var initialLayer = (savedLayer && LAYERS[savedLayer]) ? savedLayer : 'temperature';

        var switcher = document.getElementById('layer-switcher');
        if (switcher) {
            switcher.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-layer]');
                if (!btn) return;
                var layerId = btn.dataset.layer;
                if (!LAYERS[layerId]) return;
                switcher.querySelectorAll('[data-layer]').forEach(function (b) {
                    b.className = 'btn btn-outline-secondary';
                });
                btn.className = 'btn btn-primary';
                sessionStorage.setItem(SESSION_KEY, layerId);
                renderLayer(layerId);
            });

            var activeBtn = switcher.querySelector('[data-layer="' + initialLayer + '"]');
            if (activeBtn && initialLayer !== 'temperature') {
                switcher.querySelectorAll('[data-layer]').forEach(function (b) {
                    b.className = 'btn btn-outline-secondary';
                });
                activeBtn.className = 'btn btn-primary';
            }
        }

        renderLayer(initialLayer);
    })();
</script>
{% endif %}
{% endblock %}
